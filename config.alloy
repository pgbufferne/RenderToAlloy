logging {
  level  = "info"
  format = "logfmt"
}

// Scrape l'exporter Python (même conteneur, donc localhost)
prometheus.scrape "render_exporter" {
  targets = [
    {"__address__" = "localhost:9200"},
  ]
  honor_labels    = true
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.metrics_hosted_prometheus.receiver]
}

// Scrape les métriques applicatives de rok-kvk-dashboard (endpoint /metrics.php)
prometheus.scrape "rok_app" {
  targets = [
    {
      "__address__"       = "rok-kvk-dashboard.onrender.com/",
      "__scheme__"         = "https",
      "__metrics_path__"   = "/metrics.php",
    },
  ]
  params = {
    api_key = [env("ROK_APP_METRICS_TOKEN")],
  }
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.metrics_hosted_prometheus.receiver]
}

// (Optionnel mais utile) Auto-monitoring d'Alloy lui-même
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.metrics_hosted_prometheus.receiver]
}

// Envoi vers Grafana Cloud (remote_write)
prometheus.remote_write "metrics_hosted_prometheus" {
  endpoint {
    name = "hosted-prometheus"
    url  = "https://prometheus-prod-65-prod-eu-west-2.grafana.net/api/prom/push"

    basic_auth {
      username = env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
